{
  "name": "16competitive-client",
  "version": "2026.930.6",
  "description": "Ranked Launcher for CS 1.6",
  "main": "./out/main/index.js",
  "author": "papamo.dev",
  "homepage": "https://16competitive.papamo.dev",
  "allowScripts": {
    "electron@39.8.10": true
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "verify": "npm run lint && npm run typecheck",
    "build:helper": "node scripts/build-game-inspector.mjs",
    "build:scoreboard": "node scripts/build-scoreboard-overlay.cjs",
    "test:helper": "node --experimental-strip-types --experimental-vm-modules --test scripts/helper-release.test.mjs scripts/helper-supervisor.test.mjs scripts/backend-policy.test.mjs scripts/release-helper.test.mjs",
    "test:scoreboard": "node --experimental-strip-types --test scripts/scoreboard-feed.test.cjs scripts/crosshair-config.test.mjs scripts/voice-ptt.test.mjs scripts/windows-cosmetic-compatibility.test.mjs",
    "start": "electron-vite dev",
    "dev": "electron-vite dev",
    "marketing:lobby": "electron-vite dev --mode marketing",
    "overlay:probe": "node scripts/start-cosmetic-overlay-probe.cjs",
    "scoreboard:probe": "node scripts/start-cosmetic-overlay-probe.cjs scoreboard",
    "nextclient:overlay:probe": "node scripts/start-nextclient-overlay-probe.cjs",
    "preview": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir --publish never",
    "build:win": "npm run build && electron-builder --win --publish never",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "build:linux": "npm run build && electron-builder --linux AppImage --publish never",
    "build:linux:arm64": "npm run build && electron-builder --linux AppImage --arm64 --publish never",
    "release:date": "node scripts/set-date-version.mjs",
    "release:notes": "node scripts/generate-changelog.mjs",
    "release": "npm run verify && npm run test:helper && npm run test:scoreboard && node scripts/release-today.mjs",
    "build:web": "tsc --noEmit -p tsconfig.web.json --composite false && vite build --config vite.webapp.config.ts",
    "prepare:helper": "node --experimental-strip-types scripts/prepare-game-inspector.mjs",
    "release:check": "node --experimental-strip-types scripts/prepare-game-inspector.mjs --check-all",
    "predev": "npm run build:helper && npm run build:scoreboard",
    "prebuild": "npm run build:scoreboard"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/audiowide": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "electron-updater": "^6.3.9",
    "fast-dataview": "^0.3.3",
    "gl-matrix": "^3.4.4",
    "lucide-react": "^1.37.0",
    "multi-array-view": "^0.1.7",
    "ramda": "^0.32.0",
    "react-color": "^2.19.3",
    "react-dropzone": "^20.1.1",
    "react-markdown": "^10.1.0",
    "react-select": "^5.10.2",
    "react-toastify": "^11.1.0",
    "react-world-flags": "^2.0.0-beta.4",
    "styled-components": "^6.5.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.101.1",
    "three-orbit-controls": "^82.1.0",
    "vite-plugin-bundle-obfuscator": "^1.13.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/ramda": "^0.32.0",
    "@types/react": "^19.2.7",
    "@types/react-color": "^3.0.13",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.93.19",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "esbuild": "0.25.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
