// Inspectable decompilation; final MDL uses byte-preserving texture import.
$modelname "ef_gundrop.mdl"
$scale 1.0
$eyeposition -0.0 0.0 77.0
$body "body" "ref_drop.smd"
$texrendermode "portal02.bmp" "fullbright"
$texrendermode "portal02.bmp" "additive"
$texrendermode "portal03.bmp" "fullbright"
$texrendermode "portal03.bmp" "additive"
$sequence "idle" "idle.smd" fps 30 loop
