# Main-process development configuration. These values are not exposed to the renderer.
API_BASE_URL=http://127.0.0.1:3000
# MATCHMAKING_WS_URL=ws://127.0.0.1:3000/matchmaking/ws
# CS16_CLIENT_EXECUTABLE_PATH=/absolute/path/to/hl_linux
# CS16_CLIENT_GAME_DIRECTORY=/absolute/path/to/Counter-Strike

# Discord Rich Presence. Upload resources/icon.png as a Discord Rich Presence
# Art Asset with the key "logo", and also use it as the Discord application icon.
# DISCORD_CLIENT_ID=123456789012345678
# DISCORD_LARGE_IMAGE_KEY=logo
# Normally discovered automatically. Set only for a custom/sandboxed arRPC
# server (separate multiple paths with : on Linux/macOS or ; on Windows).
# DISCORD_IPC_PATH=/absolute/path/to/discord-ipc-0
